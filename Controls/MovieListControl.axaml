                    <StackPanel Orientation="Vertical" >
                        <Grid ShowGridLines="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="350"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <!--
                            <TextBox Classes="c1" Text="{Binding  SortOrders[0], Mode=OneWay}" Grid.Row="0"  Grid.Column="0"   />
                            <TextBox Classes="c1" Text="{Binding  SortOrders[1], Mode=OneWay}" Grid.Row="0"  Grid.Column="1"   />
                            <TextBox Classes="c1" Text="{Binding  SortOrders[2], Mode=OneWay}" Grid.Row="0"  Grid.Column="2"   />
                            <TextBox Classes="c1" Text="{Binding  SortOrders[3], Mode=OneWay}" Grid.Row="0"  Grid.Column="3"   />
                            <TextBox Classes="c1" Text="{Binding  SortOrders[4], Mode=OneWay}" Grid.Row="0"  Grid.Column="4"   />
                            <TextBox Classes="c1" Text="{Binding  SortOrders[5], Mode=OneWay}" Grid.Row="0"  Grid.Column="5"   />
                            <TextBox Classes="c1" Text="{Binding  SortOrders[6], Mode=OneWay}" Grid.Row="0"  Grid.Column="6"   />
                            <TextBox Classes="c1" Text="{Binding  SortOrders[7], Mode=OneWay}" Grid.Row="0"  Grid.Column="7"   />
                            <TextBox Classes="c1" Text="{Binding  SortOrders[8], Mode=OneWay}" Grid.Row="0"  Grid.Column="8"   />
                            <TextBox Classes="c1" Text="{Binding  SortOrders[9], Mode=OneWay}" Grid.Row="0"  Grid.Column="10"   />
                            
                            <tcb:ImagedButton  Grid.Column="11"
                                               Grid.Row="0"
                                               
                                               LabelText="Sort"
                                               ImageSource="avares://TaymadeControls/Assets/sort.png"
                                               />



                            <tcb:ImagedButton Grid.Column="12"
                                              Grid.Row="0"
                                             
                                              HotKey="Escape"
                                              LabelText="Clear"
                                              HotKeyText="Esc"
                                              ImageSource="avares://TaymadeControls/Assets/cleaning.png"
                                              />

                            <TextBox Classes="C2" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="9" 
                                     Text="{Binding ProcessOutput}"/>
                            <ProgressBar Value="{Binding ProgressPercent}" ShowProgressText="True" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="10"  Minimum="0" Maximum="100" />
                            

                            <tcb:ImagedButton Margin="10,0,0,0"
                                              Grid.Column="11"
                                              Grid.Row="1"
                                              Name="LastMovie"
                                              HotKey="Ctrl+L"
                                              LabelText="Last Movie"
                                              HotKeyText="Ctrl+L"
                                              ImageSource="avares://TaymadeControls/Assets/Last.png"
                                              />
                                              -->
                        </Grid>
                        <DataGrid Name="dgMovies" 
                                  IsVisible="True"
                                  AutoGenerateColumns="False"
                                  VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Visible"
                                  Height="250"
                                  RowHeight="25"
                                  VerticalAlignment="Center"
                                  CanUserResizeColumns="True"
                                  ItemsSource="{Binding MovieList}"
                                  SelectedItem="{Binding CurrentMovie}"
                                  
                                  >
                            <!--	<DataGrid.KeyBindings>
                            <KeyBinding Gesture="PageDown" Command="{Binding PageDownCommand}" CommandParameter="{Binding BoundGrid}" />
                            <KeyBinding Gesture="PageUp" Command="{Binding PageUpCommand}" />
                            <KeyBinding Gesture="Home" Command="{Binding PageHomeCommand}" />
                            <KeyBinding Gesture="End" Command="{Binding PageEndCommand}" />
                            </DataGrid.KeyBindings> -->
                            <DataGrid.Styles>
                                <!--<Style Selector=":is(DataGridRow)">
                                <Setter Property="Background" Value="{Binding BackColour}"/>
                                </Style> -->

                            </DataGrid.Styles>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" />

                                <DataGridTextColumn Header="Name" 
                                                    Binding="{Binding MovieName}"
                                                    Width="200"  
                                                    SortMemberPath="MovieName" />
                                    
                          
                                <DataGridTextColumn Header="Information" 
                                                    Width="350"  Binding="{Binding Info}">
                                    
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="#Bookmarks" Binding="{Binding ImagesCount}" />
                                <DataGridTextColumn Header="%Unmarked" Binding="{Binding PercentUnBookmarked}" />
                                <DataGridTextColumn Header="Duration" Binding="{Binding MovieDuration, Mode=OneWay}" />
                                <DataGridTextColumn Header="Added" Binding="{Binding Added, Mode=OneWay}" />
                                <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedOn, Mode=OneWay}" />
                                <DataGridCheckBoxColumn Header="Has Chapter" Binding="{Binding HasChapters, Mode=OneWay}" />
                                <DataGridCheckBoxColumn Header="Has Episode" Binding="{Binding HasEpisodes, Mode=OneWay}" />
                                <DataGridCheckBoxColumn Header="Selected" Binding="{Binding IsSelected, Mode=OneWay}" />
                                <DataGridTextColumn Header="Rating" Binding="{Binding MovieExtension.Rating, Mode=OneWay}" />
                                <DataGridTextColumn Header="Year" Binding="{Binding Year, Mode=OneWay}" />
                                <DataGridTextColumn Header="Episode No" Binding="{Binding EpisodeNumber, Mode=OneWay}" />
                                
                                
                            </DataGrid.Columns>

                            <DataGrid.ContextMenu>
                                <ContextMenu  Name="MovieMenu">
                                    <MenuItem Header="Delete Movie"  />
                                    <MenuItem Header="Delete Movie Entity"  />
                                    <MenuItem Header="Conversion">
                                        <MenuItem Header="To MTS" />
                                        <MenuItem Header="-  Move MTS"  />
                                        <MenuItem Header="To MP4"  />
                                        <MenuItem Header="-  Move MP4" />
                                        <MenuItem Header="Trim Movie"  />

                                    </MenuItem>
                                    <MenuItem Header="Add NFO File"  />
                                    <MenuItem Header="Play">
                                        <MenuItem Header="Play VLC"  HotKey="Ctrl+P" />
                                        <MenuItem Header="Play From Last" 
                                                  
                                                  HotKey="Ctrl+L"/>
                                    </MenuItem>
                                    <MenuItem Header="Edit"  />
                                    <MenuItem Header="Details" />
                                    <MenuItem Header="Join">
                                        <MenuItem Header="Clear List" 
                                                  />
                                        <MenuItem Header="Join List" 
                                                  
                                                  Name="JoinMovies"/>
                                    </MenuItem>
                                    <MenuItem Header="Cast Shared Movies"
                                              
                                              />
                                    <MenuItem	Header="Search" 
                                                 
                                                 HotKey="Ctrl+F" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>


                    </StackPanel>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    
    </StackPanel>

</UserControl>
