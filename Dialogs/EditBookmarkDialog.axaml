<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:TaymadeEntities.ViewModels"
		xmlns:mo="using:TaymadeEntities.Models"
		xmlns:tcb="using:TaymadeControls.Buttons"
		xmlns:tc="using:TaymadeControls"
		mc:Ignorable="d" d:DesignWidth="1800" d:DesignHeight="1250"
		WindowState="Maximized"
		x:DataType="mo:Bookmark"
		x:Class="TaymadeEntities.Dialogs.EditBookmarkDialog"
		Title="Edit Bookmark Dialog">

	

	<Border CornerRadius="6" BorderBrush="Gray" Background="LightGray" BorderThickness="2" DockPanel.Dock="Top">
		<StackPanel Orientation="Vertical" >
			<tc:HeaderControl2
			Height="90"
			Title="Edit Bookmarks"
			>
			</tc:HeaderControl2>
			<Grid ShowGridLines="False">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="120"/>
					<ColumnDefinition Width="100"/>
					<ColumnDefinition Width="100"/>
					<ColumnDefinition Width="100"/>
					<ColumnDefinition Width="10"/>

					<ColumnDefinition Width="100"/>
					<ColumnDefinition Width="100"/>

				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="40"></RowDefinition>
					<RowDefinition Height="40"></RowDefinition>
					<RowDefinition Height="40"></RowDefinition>
					<RowDefinition Height="40"></RowDefinition>
					<RowDefinition Height="40"></RowDefinition>
					<RowDefinition Height="40"></RowDefinition>

				</Grid.RowDefinitions>
				<TextBlock Classes="h1" Text="Name" TextAlignment="Left" Grid.Column="0" Grid.Row="0"/>
				<TextBox Classes="c14" Text="{Binding Name}" Grid.Row="0" IsReadOnly="False"  Grid.Column="1" Grid.ColumnSpan="3"/>
				<AutoCompleteBox Classes="c14" Name="AutoComplete" 
					  Grid.Column="5"  />
				<TextBlock Classes="h1" Text="Image Path" TextAlignment="Left" Grid.Column="0" Grid.Row="1"/>
				<TextBox Classes="c14" Text="{Binding ImagePath, Mode=TwoWay }" Grid.Row="1" IsReadOnly="False"  Grid.Column="1"  Grid.ColumnSpan="3"/>
				<TextBox Classes="c14"
			 
			 Grid.Row="0"
			 IsReadOnly="False" 
			 Grid.Column="6"/>
				<tcb:ImagedButton Grid.Row="1"
								  Grid.Column="5"
								  
								  ImageSource="avares://TaymadeControls/Assets/MovieReel.jpg"
								  LabelText="Grab Image"
								  HotKeyText=""/>
				<tcb:ImagedButton Grid.Row="2"
								  Grid.Column="6" 
								  
								  ImageSource="avares://TaymadeControls/Assets/add_icon.png"
								  LabelText="Add Text"
								  HotKeyText=""/>

				<tcb:ImagedButton Grid.Row="1"
					  Grid.Column="6"
					 
								  ImageSource="avares://TaymadeControls/Assets/Cross2.png"
								  LabelText="Del Image"
								  HotKeyText=""/>
				<TextBlock Classes="h1" Text="Comment" TextAlignment="Left" Grid.Column="0" Grid.Row="2"/>
				<TextBox Classes="c14" Text="{Binding Comment, Mode=TwoWay }" Grid.Row="2" IsReadOnly="False"  Grid.Column="1"  Grid.ColumnSpan="3"/>

				<TextBlock Classes="h1" Text="Type" TextAlignment="Left" Grid.Column="0" Grid.Row="3"/>
				<TextBox Classes="c14" FontSize="14" Text="{Binding Type, Mode=TwoWay }" Grid.Row="3" IsReadOnly="False"  Grid.Column="1"  Grid.ColumnSpan="3"/>

				<TextBlock Classes="h1" Text="Time" TextAlignment="Left" Grid.Column="0" Grid.Row="4"/>
				<TextBox Classes="c14" FontSize="14" Text="{Binding FormattedTime, Mode=TwoWay }" Grid.Row="4" IsReadOnly="False"  Grid.Column="1" />
				<TextBox Classes="c14" FontSize="14" Text="{Binding Time, Mode=TwoWay }" Grid.Row="4" IsReadOnly="False"  Grid.Column="5"/>
				<NumericUpDown Value="{Binding Hours}" Increment="1" Minimum="0" Maximum="5" Grid.Row="5" Grid.Column="1" AllowSpin="True" ShowButtonSpinner="True" ButtonSpinnerLocation="Right"/>
				<NumericUpDown Value="{Binding Minutes}" Increment="1" Minimum="0" Maximum="60" Grid.Row="5" Grid.Column="2"/>
				<NumericUpDown Value="{Binding Seconds}" Increment="1" Minimum="0" Maximum="60" Grid.Row="5" Grid.Column="3"/>
				<NumericUpDown Value="{Binding Milli}" Increment="10" Minimum="0" Maximum="999" Grid.Row="5" Grid.Column="5"/>
			</Grid>
			<Border CornerRadius="6" BorderBrush="Gray" Background="WhiteSmoke" BorderThickness="2" DockPanel.Dock="Bottom" >
				<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
					<StackPanel Orientation="Horizontal"  HorizontalAlignment="Center" Height="500" >
						<Image Source="{Binding ImageBMP}" Name="Poster" DockPanel.Dock="Top" IsVisible="{Binding BMPVisible}" />
					</StackPanel>
				</ScrollViewer>
			</Border>
			<Border CornerRadius="6" BorderBrush="Gray" Background="LightGray" BorderThickness="2" DockPanel.Dock="Bottom">
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Center"
							Height="50">
					<tcb:OkButton Click="OkButton_Click" />
					<tcb:CancelButton Click="CancelButton_Click" />
				</StackPanel>
			</Border>
		</StackPanel>
	</Border>
</Window>
