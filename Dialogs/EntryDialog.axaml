<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		xmlns:vm="using:TaymadeEntities.ViewModels"
		xmlns:uc="using:TaymadeEntities.Controls"
		x:DataType="vm:EntryDialogModel"

		x:Class="TaymadeEntities.Dialogs.EntryDialog"
		Title="Cast Editor">

	<Window.Styles>
		<StyleInclude Source="avares://TaymadeControls/Styles/TaymadeStyles.axaml"/>
	</Window.Styles>

	<Design.DataContext>
		<vm:EntryDialogModel/>
	</Design.DataContext>

	<Border CornerRadius="6" BorderBrush="Gray" Background="LightGray" BorderThickness="2" DockPanel.Dock="Top">

		<DockPanel	LastChildFill="True" >
			<StackPanel Orientation="Vertical" DockPanel.Dock="Top">
				<TextBox Classes="c1" Text="{Binding EntryText}"
						 Name="entryText"
						 Margin="25,25,5,5"
						 >
					<TextBox.ContextMenu>
						<ContextMenu  Name="EntryTextMenu">
							<MenuItem Header="Hyphenate Spaces" Command="{Binding Hyphenate}" />
							<MenuItem Header="Underscore Spaces" Command="{Binding Underscore}" />
							<MenuItem Header="Shorten" Command="{Binding Shorten}" />
						</ContextMenu>
					</TextBox.ContextMenu>
				</TextBox>
				<TextBox Classes="c1" Text="{Binding EntryTime}" Name="entryTime" Margin="25,25,5,5"/>
				<ComboBox Name="entryList"
						  SelectedItem="{Binding SelectedItem}"
						  Margin="25,25,5,5"
						  ItemsSource="{Binding ItemList}" Width="220"/>
				<DatePicker Name="entryDate" DayVisible="True"  Margin="25,25,5,5" MonthVisible="True"
							YearFormat="yyyy" YearVisible="True"
							SelectedDate="{Binding EntryDate}" >

				</DatePicker>
				<StackPanel Name="EpisodePanel" 
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							>
					<Grid ShowGridLines="False" RowSpacing="5" ColumnSpacing="5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="100"/>
							<ColumnDefinition Width="70"/>
							<ColumnDefinition Width="50"/>
							<ColumnDefinition Width="100"/>
							<ColumnDefinition Width="20"/>
							<ColumnDefinition Width="100"/>
							<ColumnDefinition Width="100"/>
							<ColumnDefinition Width="100"/>
							<ColumnDefinition Width="100"/>
							</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							
						</Grid.RowDefinitions>
						<TextBlock  Classes="h2"  Text="Name" Grid.Column="0" Grid.Row="0"/>
								<TextBox Classes="c1" Height="30"  Text="{Binding Episode.Name}"
										 Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="5" />

								<TextBlock  Classes="h2"  Text="Overview"  Grid.Column="0" Grid.Row="1"/>
								<TextBox  Classes="c1" Height="30"  Text="{Binding Episode.Overview}" 
										  Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="5" TextWrapping="Wrap" />
						<TextBlock  Classes="h2"  Text="Episode No"
											Grid.Column="6" Grid.Row="0"/>
						<TextBox   Classes="c1" Height="30"
										   Text="{Binding Episode.EpisodeNumber}"
										   Grid.Column="7" Grid.Row="0"  />
								<TextBlock  Classes="h2"  Text="DB ID"  Grid.Column="0" Grid.Row="2"/>
								<TextBox  Classes="c1" Height="30"  Text="{Binding Episode.TMID}" Grid.Column="1" Grid.Row="5"  TextWrapping="Wrap" />
								<TextBlock  Classes="h2"  Text="Air Date"  Grid.Column="6" Grid.Row="2"/>
								<TextBox  Classes="c1" Height="30"  
										  Text="{Binding Episode.AirDateString, Mode=TwoWay}" 
										  Grid.Column="7" Grid.Row="2"  />
					</Grid>
				</StackPanel>
			</StackPanel>
			<StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" HorizontalAlignment="Center" Height="50">
				<Button Content="OK" Margin="5" Click="Accept_Click" Name="Accept" >

				</Button>
				<Button Content="Cancel" Margin="5" Click="Cancel_Click" Name="Cancel" >
				</Button>
				<!--
				<Button Content="Search" Margin="5" Command="{Binding Search}" Name="Search" />
				-->
			</StackPanel>
		</DockPanel>
	</Border>

</Window>
