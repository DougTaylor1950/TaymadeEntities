        <StackPanel Name="MovieControlsPanel"
                    Orientation="Vertical"
                    Margin="5,5,5,5" >
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" >

                <StackPanel Orientation="Vertical" Height="500">
