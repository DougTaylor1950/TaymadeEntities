<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:TaymadeEntities.ViewModels"
		xmlns:tc="using:TaymadeControls"
		xmlns:tcb="using:TaymadeControls.Buttons"
		xmlns:mo="using:StoryViewer.Models"
		mc:Ignorable="d" d:DesignWidth="1800" d:DesignHeight="1200"
		x:Class="TaymadeEntities.Dialogs.StoryMaintenance"
		x:DataType="vm:StoryViewModel"
		Title="StoryMaintenance">

	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:StoryViewModel/>
	</Design.DataContext>

	<Window.Styles>
		<StyleInclude Source="avares://TaymadeControls/Styles/TaymadeStyles.axaml"/>
	</Window.Styles>

	<Border CornerRadius="6" BorderBrush="Gray"
			BorderThickness="2"
			>
		<StackPanel Orientation="Vertical">
			<tc:HeaderControl2 Title="Story Maintenance"
							   Height="80"
							   Background="{Binding $self.BermudaTriangleBrush}"
							   Name="StoryMaintenaceHeaderControl"
							   SubtitleA=""
							   SubtitleAIsVisible="True"
							   />
			<StackPanel Orientation="Vertical"
						Height="400">
				<Border BorderBrush="Black"
						BorderThickness="2"
						CornerRadius="10">
					<StackPanel Orientation="Horizontal"	>
						<StackPanel Orientation="Vertical"
									Width="280"	>
							<ListBox	ItemsSource="{Binding Authors}"
									 SelectedItem="{Binding CurrentAuthor}"
									 Height="300"/>
							<StackPanel Orientation="Horizontal" Width="280" >
								<tcb:ImagedButton
								LabelText="Add Author"
								ImageSource="avares://TaymadeControls/Assets/add_icon.png"
								Click="AddAuthor_Click"
								Margin="5,5,5,5"
								/>
								<TextBox Text=""
										 PlaceholderText="Enter New Author"
										 Margin="5,5,5,5"
										 Name="NewAuthorName"/>

							</StackPanel>
						</StackPanel>
						<StackPanel Width="20"
									Background="LightGray"/>
						<StackPanel Orientation="Vertical" Width="300">
							<ListBox ItemsSource="{Binding SeriesList}"
									 SelectedItem="{Binding CurrentSeries}"
									 Height="300"/>
							<StackPanel Orientation="Horizontal" Width="300" >
								<tcb:ImagedButton
								LabelText="Add Series"
								ImageSource="avares://TaymadeControls/Assets/add_icon.png"
								Click="AddSeries_Click"
								Margin="5,5,5,5"
								/>
								<TextBox Text=""
										 PlaceholderText="Enter Series"
										 PlaceholderForeground="Black"
										 Margin="5,5,5,5"
										 Name="NewSeriesName"/>
							</StackPanel>


						</StackPanel>
						<StackPanel Width="20"
									Background="LightGray"/>
						<StackPanel	Orientation="Vertical"	Width="300">
							<tcb:ImagedButton LabelText="Phrases" Click="ImagedButton_Click" />
						</StackPanel>

					</StackPanel>
				</Border>
			</StackPanel>
			<Border BorderBrush="Black" BorderThickness="2" CornerRadius="5">
				<Grid ShowGridLines="False" >
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="100"/>
						<ColumnDefinition Width="500"/>
						<ColumnDefinition Width="100"/>
						<ColumnDefinition Width="500"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="50"/>
						<RowDefinition Height="50"/>
						<RowDefinition Height="50"/>
					</Grid.RowDefinitions>

					<TextBlock  Classes="h2" 
								Text="Author" 
								Grid.Row="0" 
								Grid.Column="0"
								HorizontalAlignment="Left" VerticalAlignment="Center"/>

					<TextBlock  Classes="h2" 
								Text="Series" 
								Grid.Row="0" 
								Grid.Column="2"
								HorizontalAlignment="Left" VerticalAlignment="Center"/>
					
					<TextBox Text="{Binding CurrentAuthor.Name}" 
							 Grid.Row="0" 
							 Grid.Column="1"
							 HorizontalAlignment="Right"
							 VerticalAlignment="Center"
							 Margin="5,5,5,5" 
							 Width="480"
							 Classes="c1"
							 />
					<TextBox Text="{Binding CurrentSeries.Name}" 
							 Grid.Row="0" 
							 Grid.Column="3"
							 HorizontalAlignment="Right"
							 VerticalAlignment="Center"
							 Margin="5,5,5,5" 
							 Width="480"
							 Classes="c1"
							 />
					<TextBlock Classes="h2" Text="Path" Grid.Row="1"
							   Grid.Column="0" HorizontalAlignment="Left"
							   VerticalAlignment="Center"/>
					<TextBox Text="{Binding CurrentAuthor.StoryPath}"
							 Classes="c1"
							 Grid.Row="1"
							 Grid.Column="1"
							 Margin="5,5,5,5" 
							 Width="480"
							 HorizontalAlignment="Right" 
							 VerticalAlignment="Center"/>

					<tcb:ImagedButton LabelText="Save" Grid.Row="2" Grid.Column="0" Click="SaveAuthor_Click"
									  ImageSource="avares://TaymadeControls/Assets/save_icon.png"
									  HorizontalAlignment="Left"
									  VerticalAlignment="Center"/>
				</Grid>
			</Border>
			<StackPanel Orientation="Horizontal"
						HorizontalAlignment="Center">
				<tcb:OkButton Click="OkButton_Click" />
				<tcb:CancelButton Click="CancelButton_Click" />
			</StackPanel>
		</StackPanel>
	</Border>
</Window>
