<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:vm="using:TaymadeEntities.ViewModels"
			 xmlns:c="using:TaymadeEntities.Controls"
			 xmlns:tc="using:TaymadeControls"
			 xmlns:tcb="using:TaymadeControls.Buttons"
			 xmlns:mo="using:TaymadeEntities.Models"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 d:DesignWidth="1800"
			 d:DesignHeight="400"
			 Height="400"
			 x:DataType="vm:MovieViewModel"
			 x:Class="TaymadeEntities.Controls.MovieDetailControl"
			 >

	<Design.DataContext>
		<vm:MovieViewModel/>
	</Design.DataContext>



	<Border CornerRadius="6" BorderBrush="Gray" Background="LightGray" BorderThickness="2" DockPanel.Dock="Top">
		<StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
			<Grid ShowGridLines="False">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="100"/>
					<ColumnDefinition Width="140"/>
					<ColumnDefinition Width="140"/>
					<ColumnDefinition Width="220"/>
					<ColumnDefinition Width="10"/>

					<ColumnDefinition Width="100"/>
					<ColumnDefinition Width="100"/>

					<ColumnDefinition Width="10"/>

					<ColumnDefinition Width="100"/>
					<ColumnDefinition Width="100"/>

				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="50"></RowDefinition>
					<RowDefinition Height="60"></RowDefinition>
					<RowDefinition Height="40" ></RowDefinition>
					<RowDefinition Height="40" ></RowDefinition>
					<RowDefinition Height="40" ></RowDefinition>
					<RowDefinition Height="40" ></RowDefinition>
					<RowDefinition Height="40" ></RowDefinition>
					<RowDefinition Height="40" ></RowDefinition>

				</Grid.RowDefinitions>
				<TextBlock Classes="h1" Text="Name"  Grid.Column="0" Grid.Row="0"/>
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.MovieName}" Grid.Column="1" Grid.ColumnSpan="3" />
				<TextBlock Classes="h2" HorizontalAlignment="Right"
						   Text="Year"  Grid.Column="5" Grid.Row="0" />
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.Year}" Grid.Column="6" Grid.Row="0" />
				<TextBlock Classes="h2" HorizontalAlignment="Right" 
						   Text="#bookmarks"  Grid.Column="8"
						   Grid.Row="0" />
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.ImagesCount}" Grid.Column="9" Grid.Row="0" />


				<TextBlock Classes="h2" Text="Information" HorizontalAlignment="Right"
						   Grid.Column="0"  Grid.Row="1" TextWrapping="Wrap" />
				<TextBox Classes="c1" Height="60" 
						 Text="{Binding CurrentMovie.Info}" 
						 Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" TextWrapping="Wrap"  />
				<TextBlock Classes="h2" Text="Added" 
						   HorizontalAlignment="Right"
						   Grid.Column="5" Grid.Row="1" />
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.Added, StringFormat='{}{0: dd-MMM-yyyy}'}" Grid.Column="6" Grid.Row="1" />
				<TextBlock Classes="h2" 
						   Text="Unmarked" HorizontalAlignment="Right" Grid.Column="8" Grid.Row="1" />
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.PercentUnBookmarked}" Grid.Column="9" Grid.Row="1" />


				<TextBlock Classes="h2" Text="Path" 
						   HorizontalAlignment="Right"
						   Grid.Column="0" Grid.Row="2" />
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.MoviePath}"  Grid.Column="1" Grid.Row="2"  Grid.ColumnSpan="3"/>
				<TextBlock Classes="h2" 
						   Text="Modified" 
						   HorizontalAlignment="Right"
						   Grid.Column="5" Grid.Row="2" />
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.ModifiedOn, StringFormat='{}{0: dd-MMM-yyyy}'}" Grid.Column="6" Grid.Row="2" />
				<TextBlock Classes="h2" 
						   Text="Rating" HorizontalAlignment="Right" Grid.Column="8" Grid.Row="2" />
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.MovieExtension.Rating}" Grid.Column="9" Grid.Row="2" />
				<TextBlock Classes="h2"
						   Text="Link" HorizontalAlignment="Right" Grid.Column="8" Grid.Row="3" />
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.link}" Grid.Column="9" Grid.Row="3" />

				<TextBlock Classes="h2" 
						   HorizontalAlignment="Right"
						   Text="XSPF Path" Grid.Column="0" Grid.Row="3" />
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.Path}"  Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="3" />
				<TextBlock Classes="h2" Text="TMDBID" 
						   HorizontalAlignment="Right"
						   Grid.Column="5" Grid.Row="3" />
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.TMDBID}" Grid.Column="6" Grid.Row="3" />

				<TextBlock Classes="h2" 
						   Text="Image Path" 
						   HorizontalAlignment="Right"
						   Grid.Column="0" Grid.Row="4" />
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.ImagePath}"  Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="3" />
				<TextBlock Classes="h2" 
						   HorizontalAlignment="Right"
						   Text="IMDBID"  Grid.Column="5" Grid.Row="4" />
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.IMDBID}" Grid.Column="6" Grid.Row="4" />

				<TextBlock Classes="h2" 
						   Text="Genre" 
						   HorizontalAlignment="Right"
						   Grid.Column="0" Grid.Row="5" />
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.FilmGroup}"  Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="3" />
				<TextBlock Classes="h2" 
						   HorizontalAlignment="Right"
						   Text="Duration" Grid.Column="5" Grid.Row="5" />
				<TextBox Classes="c1"  Text="{Binding CurrentMovie.RunTime}"  Grid.Column="6" Grid.Row="5" />
				<TextBlock Text="Director" 
						   Grid.Column="8" 
						   Grid.Row="5" Classes="h2"
						   HorizontalAlignment="Right"/>
							<ComboBox  Classes="c1" 
									   ItemsSource="{Binding DirectorList}"
									   Grid.Column="9" Grid.Row="5" 
									   SelectedItem="{Binding CurrentMovie.Director}" />

				<tcb:ImagedButton  Grid.Row="6" Grid.Column="0"
								   Click="Save"
								   LabelText="Save"
								   ImageSource="avares://TaymadeControls/Assets/save_icon.png"
								   HotKeyText="" />



				<ComboBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Name="cbGroup"  ItemsSource="{Binding Phrases}" SelectedItem="{Binding NewPhrase}"/>
				<ComboBox Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="3" Name="cbSubGroup"  ItemsSource="{Binding SubPhrases}" SelectedItem="{Binding NewSubPhrase}"/>
				<tcb:ImagedButton
				Command="{Binding GeneratePhrase}"
				Grid.Row="6" Grid.Column="3"
				LabelText="Add"
				ImageSource="avares://TaymadeControls/Assets/add_icon.png"
				HotKeyText=""
				/>

				<CheckBox Grid.Column="5" Grid.Row="6" Grid.ColumnSpan="2" Content="Has Episodes" IsChecked="{Binding CurrentMovie.HasEpisodes}"/>
				<TextBlock Classes="h2" 
						   Text="Episode" 
						   Grid.Column="2" 
						   Grid.Row="7" 
						   HorizontalAlignment="Right"
						   IsVisible="{Binding	CurrentMovie.HasEpisodes}"
						   />

				<tcb:ImagedButton
				
				Grid.Row="7" Grid.Column="0"
				LabelText="Edit Movie"
				ImageSource="avares://TaymadeControls/Assets/edit_icon.png"
				HotKeyText=""
				/>

				<tcb:ImagedButton
				Click="RefreshMovie_Click"
				Grid.Row="7" Grid.Column="1"
				LabelText="Refresh"
				ImageSource="avares://TaymadeControls/Assets/Refresh.png"
				HotKeyText=""
				/>

				<TextBox Classes="c1"  Text="{Binding CurrentMovie.EpisodeEntity.Name}" 
						 
						 IsVisible="{Binding	CurrentMovie.HasEpisodes}" 
						 Grid.Column="3" Grid.ColumnSpan="7"
						 Grid.Row="7" />
			</Grid>
			<Border BorderBrush="Black"
					BorderThickness="2"
					CornerRadius="5"
					Margin="5,5,5,5">
			<Image   Name="Poster" DockPanel.Dock="Bottom" Source="{Binding CurrentMovie.ImageBMP}"> </Image> 
			</Border> 
			<ScrollViewer BorderBrush="Black"
				 BorderThickness="2"
				 VerticalScrollBarVisibility="Visible"
				 HorizontalScrollBarVisibility="Visible"
				 HorizontalAlignment="Stretch">
			<DataGrid x:DataType="vm:MovieViewModelBase"
					  ItemsSource="{Binding CurrentMovie.MovieGenres}"
					  AutoGenerateColumns="False"
					  VerticalScrollBarVisibility="Visible"
					  HorizontalScrollBarVisibility="Visible"
					  Margin="10,90,10,10"
					  >
				<DataGrid.Columns>
					<DataGridTextColumn Header="Genres" Binding="{Binding Description}" />
				</DataGrid.Columns>
			</DataGrid>
			</ScrollViewer>
		</StackPanel>

	</Border>
</UserControl>
