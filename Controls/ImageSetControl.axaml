<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:TaymadeEntities.ViewModels"

			 xmlns:tc="using:TaymadeControls"
			 xmlns:tcb="using:TaymadeControls.Buttons"
			 mc:Ignorable="d" d:DesignWidth="1900" d:DesignHeight="1100"
			 Height="1100"
			 x:DataType="vm:ImageSetViewModel"
			 x:Class="TaymadeEntities.Controls.ImageSetControl">

	<Design.DataContext>
		<vm:ImageSetViewModel/>
	</Design.DataContext>


	<StackPanel>
		<StackPanel Orientation="Horizontal">
		</StackPanel>
		<TabControl SelectionChanged="TabControl_SelectionChanged"

					Name="MainTabControl">
			<TabItem Header="Images and Folders"
					 Name="Images"
					 >

				<StackPanel Orientation="Vertical" >
					<StackPanel Orientation="Vertical">
						<tc:HeaderControl2 Title="Images"
										   TitleForeground="Green"
										   TitleBackground="LightGray"
										   Background="{Binding $self.CameraTileBrush}"
										   Height="50" />

					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<StackPanel Orientation="Vertical" HorizontalAlignment="Left" Width="200">
							<DataGrid AutoGenerateColumns="False"
									  Name="dgImageFolders"
									  ItemsSource="{Binding RootFolder.SubDirectoryList}"
									  SelectedItem="{Binding RootFolder.CurrentImageFolder}"

									  >

								<DataGrid.Columns>
									<DataGridTextColumn Header="Name" Binding="{Binding Name}" />
								</DataGrid.Columns>
								<DataGrid.ContextMenu>
									<ContextMenu Name="ImgFolderMnu">
										<MenuItem Header="Create Subfolder"
												  Command="{Binding CreateSubFolder}" />
										<MenuItem Header="Refresh Sub Folders" Command="{Binding RefreshSubDir}" />
									</ContextMenu>
								</DataGrid.ContextMenu>
							</DataGrid>
							<DataGrid AutoGenerateColumns="False"
									  Name="dgSubFolders"
									  ItemsSource="{Binding RootFolder.CurrentImageFolder.SubDirectoryList}"
									  SelectedItem="{Binding RootFolder.CurrentSubFolder}"

									  Height="400" VerticalScrollBarVisibility="Visible">
								<DataGrid.Columns>
									<DataGridTextColumn Header="Name" Binding="{Binding Name}" />
									<DataGridCheckBoxColumn Header="Move To" Binding="{Binding Selected}" />

								</DataGrid.Columns>
								<DataGrid.ContextMenu>
									<ContextMenu Name="SubImgFolderMnu">
										<MenuItem Header="Refresh" Command="{Binding RefreshSubFolder}" />
										<MenuItem Header="Delete Sub Folder" Command="{Binding DeleteSubFolder}" />
										<MenuItem Header="Save Sub Folder" Click="SaveSubFolder_Click" />
										<MenuItem Header="Load Sub Folder" Click="LoadSubFolder_Click" />
									</ContextMenu>
								</DataGrid.ContextMenu>
							</DataGrid>
							<TextBlock Text="Path"/>
							<TextBox Text="{Binding RootFolder.CurrentSubFolder.Path}" />
							<TextBlock Text="Comment"/>
							<TextBox Text="{Binding RootFolder.CurrentSubFolder.Comments}" />
							<TextBlock Text="Count"/>
							<TextBox Text="{Binding RootFolder.CurrentSubFolder.ImageItems.Count}" />
							<TextBlock Text="Speed"/>
							<TextBox Text="{Binding RootFolder.CurrentSubFolder.Speed}" />
						</StackPanel>
						<!-- Image Items-->
						<StackPanel Width="20" Background="DarkGray"/>

						<StackPanel Orientation="Vertical" Width="400">
							<StackPanel Orientation="Vertical">
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
									<tcb:ImagedButton Command="{Binding AddPictures}"
													  Margin="10"
													  ImageSource="avares://TaymadeControls/Assets/add_icon.png"

													  LabelText="Add Pictures"
													  HotKeyText=""
													  />
								</StackPanel>
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
									<!--<Image Source="{Binding CurrentIcon}"
									Height="40"
									Width="40"
									Margin="10"/> -->



									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="60"/>
											<RowDefinition Height="60"/>
										</Grid.RowDefinitions>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="150"/>
											<ColumnDefinition Width="150"/>
										</Grid.ColumnDefinitions>


										<tcb:ImagedButton Command="{Binding PlayButton_Click}"
														  Margin="10"
														  HotKey="Space"
														  ImageSource="avares://TaymadeControls/Assets/play.png"
														  Name="btnPlayContent"
														  LabelText="Play"
														  ImageHeight="32"
														  ImageWidth="32"
														  IsImageVisible="True"
														  Grid.Row="0"
														  Grid.Column="0"
														  />
										<tcb:ImagedButton Command="{Binding NextButton_Click}"
														  Margin="10"
														  ImageSource="avares://TaymadeControls/Assets/next.png"
														  ImageHeight="32"
														  ImageWidth="32"
														  LabelText="Next Image"
														  Grid.Row="1"
														  Grid.Column="0"
														  HotKeyText=""/>


										<tcb:ImagedButton Command="{Binding PrevButton_Click}" Margin="10"
														  ImageSource="avares://TaymadeControls/Assets/prev.png"
														  ImageHeight="32"
														  ImageWidth="32"
														  LabelText="Prev Image"
														  Grid.Row="1"
														  Grid.Column="1"
														  HotKeyText=""/>

										<tcb:ImagedButton Command="{Binding StopButton_Click}" Margin="10"
														  HotKey="Ctrl+S"
														  ImageSource="avares://TaymadeControls/Assets/stop.png"
														  LabelText="Stop"
														  ImageHeight="32"
														  ImageWidth="32"
														  Grid.Row="0"
														  Grid.Column="1"
														  HotKeyText=""
														  />
									</Grid>
								</StackPanel>
							</StackPanel>
							<CheckBox Content="Multi Select" IsChecked="{Binding RootFolder.MultiSelect}" />
							<DataGrid ItemsSource="{Binding RootFolder.CurrentSubFolder.ImageItems}"
									  Name="dgItemImages"
									  SelectedItem="{Binding RootFolder.CurrentImageItem}"

									  Height="600" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible">
								<DataGrid.Columns>
									<DataGridTextColumn Header="Id" Binding="{Binding Id}" />
									<DataGridTextColumn Header="Name" Binding="{Binding ImageName}" />
									<DataGridCheckBoxColumn Header="Selected" Binding="{Binding Selected}" />
									<DataGridTextColumn Header="Frame Set" Binding="{Binding FrameSetIndex}"/>
								</DataGrid.Columns>
								<DataGrid.ContextMenu>
									<ContextMenu  Name="PicMenu">
										<MenuItem Header="Image Management">
											<MenuItem Header="Edit Image" Command="{Binding EditPicture}" />
											<MenuItem Header="Delete Image" Command="{Binding DeletePicture}" />
											<MenuItem Header="Delete Selected Images" Click="DeleteSelectedImages_Click" />
											<MenuItem Header="Move Image to selected folder" Command="{Binding MoveToSelectedFolder}"  />
											<MenuItem Header="Copy Image to selected folder" Command="{Binding CopyToSelectedFolder}"  />
											<MenuItem Header="Duplicate Image" Click="DuplicateImage_Click" />
										</MenuItem>
										<MenuItem Header="Reload Image" Command="{Binding ReloadPicture}" />
										<MenuItem Header="Reload Images" Click="Reloadpictures_Click" />
										<MenuItem Header="Save Sub Folder" Click="SaveSubFolder_Click" />

										<MenuItem Header="Split Here" Click="SplitFolder_Click" />
										<MenuItem Header="Rename File" Click="MenuItem_Click"  />
										<MenuItem Header="Zoom to feature" Click="Zoom_Click" />
										<MenuItem Header="Fix Image"
												  Click="FixImage_Click"
												  HotKey="Alt+F"
												  />
										<MenuItem Header="FrameSets ">
											<MenuItem Header="Add new frameset at end" Click="AddFrameSet_Click"/>
											<MenuItem Header="Add new frameset here" Click="AddFrameSetHere_Click"/>
											<MenuItem Header="Set as frameset" Click="SetFrameSet_Click"/>
											<MenuItem Header="Set Next Set Start" Click="SetNextFrameSetStart_Click"/>
											<MenuItem Header="Frameset to Video" Click="FrameSetToVideo_Click"/>
										</MenuItem>
										<MenuItem Header="Clear Selections" Click="ClearSelection_Click" />
									</ContextMenu>
								</DataGrid.ContextMenu>
							</DataGrid>

						</StackPanel>
						<StackPanel Orientation="Vertical">
							<StackPanel Width="800" Height="800">
								<Image Width="800" Height="800" Source="{Binding RootFolder.CurrentImageItem.ImageBMP}" />
							</StackPanel>
							<TextBox Text="{Binding RootFolder.CurrentImageItem.ImageName}" />
							<TextBlock Text="{Binding RootFolder.MovieInfo}" />
							<ProgressBar ShowProgressText="true"
										 Minimum="0"
										 Maximum="100"
										 Name="ShowProgress"
										 Value="{Binding ProgressPercentShow}"/>
							<Grid ShowGridLines="False">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="100" />
									<ColumnDefinition Width="100" />
									<ColumnDefinition Width="100" />
									<ColumnDefinition Width="100" />
									<ColumnDefinition Width="100" />
									<ColumnDefinition Width="100" />
									<ColumnDefinition Width="100" />
									<ColumnDefinition Width="100" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="40"/>
									<RowDefinition Height="40"/>
								</Grid.RowDefinitions>
								<TextBlock Text="Index" Grid.Row="0" Grid.Column="0" Margin="2,2,1,1"/>
								<TextBox Text="{Binding CurrentSubFolder.CurrentFrameSet.Index}" Grid.Row="0" Grid.Column="1" Margin="2,2,1,1"/>
								<TextBlock Text="Frame Rate" Grid.Row="0" Grid.Column="2" Margin="2,2,1,1"/>
								<TextBox Text="{Binding CurrentSubFolder.CurrentFrameSet.FrameRate}" Grid.Row="0" Grid.Column="3" Margin="2,2,1,1"/>
								<TextBlock Text="Start" Grid.Row="0" Grid.Column="4" Margin="2,2,1,1"/>
								<TextBox Text="{Binding CurrentSubFolder.CurrentFrameSet.StartImage}" Grid.Row="0" Grid.Column="5" Margin="2,2,1,1"/>
								<TextBlock Text="End" Grid.Row="0" Grid.Column="6" Margin="2,2,1,1"/>
								<TextBox Text="{Binding CurrentSubFolder.CurrentFrameSet.EndImage}" Grid.Row="0" Grid.Column="7" Margin="2,2,1,1"/>
								
								<TextBlock Text="Zoom Duration" Grid.Row="1" Grid.Column="2" Margin="2,2,1,1"/>
								<TextBox Text="{Binding CurrentSubFolder.CurrentFrameSet.ZoomDuration}" Grid.Row="1" Grid.Column="3" Margin="2,2,1,1"/>
							</Grid>
						</StackPanel>
					</StackPanel>
				</StackPanel>
			</TabItem>

			<!-- Movies tab-->

			<TabItem Header="Movies" Name="Movies">
				<StackPanel Orientation="Vertical" Height="1000" VerticalAlignment="Top">
					<TextBlock Text="{Binding RootFolder.MovieInfo}" />
					<StackPanel Orientation="Horizontal" >
						<tcb:ImagedButton Command="{ Binding MakeMovie_Click}"
										  ImageSource="avares://TaymadeControls/Assets/MovieReel.jpg"
										  LabelText="Make Movie"
										  />


						<tcb:ImagedButton Command="{Binding PlayMovie_Click}"
										  IsVisible="{Binding RootFolder.HasTempMP4}"
										  ImageSource="avares://TaymadeControls/Assets/play.png"
										  LabelText="Play Temp Movie"
										  />

						<tcb:ImagedButton Command="{Binding PlayMP4_Click}"
										  IsVisible="{Binding RootFolder.HasMovieEntity}"
										  ImageSource="avares://TaymadeControls/Assets/play.png"
										  LabelText="Play Movie"
										  />

						<tcb:ImagedButton  Command="{Binding CreateMP4_Click}"
										   IsVisible="{Binding RootFolder.HasTempMP4}"
										   ImageSource="avares://TaymadeControls/Assets/Pharmacy.jpeg"
										   LabelText="Create Movie"
										   />

					</StackPanel>
					<TextBox Text="{Binding MissingInfo}" />
					<ProgressBar  ShowProgressText="true" Value="{Binding ProgressPercent}"/>

					<Grid ShowGridLines="False">
						<Grid.RowDefinitions>
							<RowDefinition Height="50"/>
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="100" />
							<ColumnDefinition Width="100" />
							<ColumnDefinition Width="100" />
							<ColumnDefinition Width="100" />
							<ColumnDefinition Width="100" />
							<ColumnDefinition Width="100" />
							<ColumnDefinition Width="100" />
							<ColumnDefinition Width="100" />
							<ColumnDefinition Width="100" />
							<ColumnDefinition Width="100" />	
							<ColumnDefinition Width="100" />
							<ColumnDefinition Width="100" />
							<ColumnDefinition Width="100" />
						</Grid.ColumnDefinitions>

						<TextBlock Text="FPS" Grid.Row="0" Grid.Column="0" Margin="5,5,5,5"/>
						<TextBox Text="{Binding RootFolder.CurrentSubFolder.FrameSetHeader.FPS }"
								 Grid.Row="0" Grid.Column="1" Margin="5,5,5,5"/>
						<CheckBox IsChecked="{Binding RootFolder.CurrentSubFolder.FrameSetHeader.SplitIntoMovies}"
								  Grid.Row="0" Grid.Column="2" Content="Movie Split" Margin="5,5,5,5"/>
						<TextBlock Text="Max X" Grid.Row="0" Grid.Column="3" Margin="5,5,5,5"/>
						<TextBox Text="{Binding RootFolder.CurrentSubFolder.FrameSetHeader.MaxXSize }"
								 Grid.Row="0" Grid.Column="4" Margin="5,5,5,5"/>
						<TextBlock Text="Max Y" Grid.Row="0" Grid.Column="5" Margin="5,5,5,5"/>
						<TextBox Text="{Binding RootFolder.CurrentSubFolder.FrameSetHeader.MaxYSize }"
								 Grid.Row="0" Grid.Column="6" Margin="5,5,5,5"/>
						<TextBlock Text="Zoom Count" Grid.Row="0" Grid.Column="7" Margin="5,5,5,5"/>
						<TextBox Text="{Binding RootFolder.CurrentSubFolder.FrameSetHeader.DefaultZoomFrames }"
								 Grid.Row="0" Grid.Column="8" Margin="5,5,5,5"/>
						<TextBlock Text="Frame Rate" Grid.Row="0" Grid.Column="9" Margin="5,5,5,5"/>
						<TextBox Text="{Binding RootFolder.CurrentSubFolder.FrameSetHeader.FrameRate }"
								 Grid.Row="0" Grid.Column="10" Margin="5,5,5,5"/>


						<tcb:ImagedButton LabelText="Save Header"
										  ImageSource="avares://TaymadeControls/Assets/save_icon.png"
										  Click="SaveHeaderButton_Click"
										  />
					</Grid>

					<StackPanel Orientation="Vertical" VerticalAlignment="Top">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="100"/>
								<ColumnDefinition Width="300"/>
								<ColumnDefinition Width="100"/>
								<ColumnDefinition Width="300"/>
								<ColumnDefinition Width="100"/>
								<ColumnDefinition Width="300"/>
								<ColumnDefinition Width="100"/>
								<ColumnDefinition Width="300"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="40" />
								<RowDefinition Height="40" />
								<RowDefinition Height="40" />
								<RowDefinition Height="40" />
							</Grid.RowDefinitions>

							<TextBlock Text="Folder Name" Grid.Row="0" Grid.Column="0"/>
							<TextBlock Text="{Binding RootFolder.CurrentSubFolder.Name}" Grid.Row="0" Grid.Column="1"/>

							<TextBlock Text="Image Count" Grid.Row="1" Grid.Column="0"/>
							<TextBlock Text="{Binding RootFolder.CurrentSubFolder.ImageItems.Count}" Grid.Row="1" Grid.Column="1"/>

							<TextBlock Text="Movie Name" Grid.Row="2" Grid.Column="0" />
							<TextBlock Text="{Binding RootFolder.CurrentMovie.MovieName}" Grid.Row="2" Grid.Column="1"/>

							<TextBlock Text="Bookmarks" Grid.Row="3" Grid.Column="0" />
							<TextBlock Text="{Binding RootFolder.CurrentMovie.Bookmarks.Count}" Grid.Row="3" Grid.Column="1"/>
							<TextBlock Text="Duration" Grid.Row="2" Grid.Column="2" />
							<TextBlock Text="{Binding RootFolder.CurrentMovie.MovieDuration}" Grid.Row="2" Grid.Column="3"/>
						</Grid>
						<StackPanel Orientation="Horizontal" VerticalAlignment="Top"
									HorizontalAlignment="Left">
							<Border BorderBrush="Black"
									BorderThickness="3"
									Height="605"
									Width="605"
									CornerRadius="5">
								<Image Name="CurrentImageControl" Width="600"
									   Height="600"
									   Source="{Binding CurrentImage}" />

							</Border>
							<StackPanel Width="10" Background="LightGray" VerticalAlignment="Top"/>
							<StackPanel Orientation="Horizontal" VerticalAlignment="Top">
								<DataGrid Name="dgFrameSets" AutoGenerateColumns="False"
										  ItemsSource="{Binding RootFolder.CurrentSubFolder.FrameSetHeader.FrameSetList}"
										  SelectedItem="{Binding RootFolder.CurrentSubFolder.CurrentFrameSet}"
										  VerticalScrollBarVisibility="Visible"
										  HorizontalAlignment="Left"
										  VerticalAlignment="Top"

										  CanUserResizeColumns="True"
										  Height="600"
										  >
									<DataGrid.Columns>
										<DataGridTextColumn Header="Index" Binding="{Binding Index}" />
										<DataGridTextColumn Header="Start" Binding="{Binding StartImage}" />
										<DataGridTextColumn Header="End" Binding="{Binding EndImage}" />
										<DataGridTextColumn Header="Frame Rate" Binding="{Binding FrameRate}" />
										<DataGridTextColumn Header="Zoom Duration" Binding="{Binding ZoomDuration}" />
										<DataGridTextColumn Header="Movie Path"
															Binding="{Binding MoviePath}"
															Width="200"/>
										<DataGridCheckBoxColumn Header="Has Movie" Binding="{Binding HasMovie}" />
									</DataGrid.Columns>
									<DataGrid.ContextMenu>
										<ContextMenu Name="FrameSetMenu">
											<MenuItem Header="Delete frameset" Click="DeleteFrameSet_Click"/>
											<MenuItem Header="Save frameset" Click="SaveFrameSet_Click"/>
											<MenuItem Header="Frameset to Video" Click="FrameSetToVideo_Click"/>
											<MenuItem Header="Check Movie Path" Click="CheckMoviePath_Click"/>
										</ContextMenu>
									</DataGrid.ContextMenu>
								</DataGrid>
								<StackPanel	Width="10"
											Background="LightGray"/>
								<StackPanel Orientation="Vertical">
									<StackPanel Orientation="Horizontal">

										<tcb:ImagedButton Command="{Binding PlayFrameMP4_Click}"
														  IsVisible="{Binding RootFolder.CurrentSubFolder.CurrentFrameSet.HasMovie}"
														  ImageSource="avares://TaymadeControls/Assets/play.png"
														  LabelText="Play Movie"
														  />
										<tcb:ImagedButton Click="SaveSubFolder_Click"
														  ImageSource="avares://TaymadeControls/Assets/save_icon.png"
														  LabelText="Save"
														  />
									</StackPanel>
									<StackPanel>
										<tcb:ImagedButton Click="JoinFrameSetMovies_Click"
														  ImageSource="avares://TaymadeControls/Assets/build.png"
														  LabelText="Build Movie"
														  />
									</StackPanel>
								</StackPanel>
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</StackPanel>
			</TabItem>


			<!-- Fix up images tab-->
			<TabItem Header="Photo Fix" Name="PhotoFix" >
				<Border CornerRadius="6" BorderBrush="Gray"
						BorderThickness="2"
						BoxShadow="5 5 10 0 #C0000000"
						VerticalAlignment="Top"
						Height="800"
						>

					<StackPanel Orientation="Horizontal" VerticalAlignment="Top" Height="800">
						<StackPanel Orientation="Vertical" VerticalAlignment="Top" Height="600" Width="750">
							<Grid ShowGridLines="False" VerticalAlignment="Top">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="100"/>
									<ColumnDefinition Width="200"/>
									<ColumnDefinition Width="10"/>

									<ColumnDefinition Width="100"/>
									<ColumnDefinition Width="200"/>

								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="40"></RowDefinition>
									<RowDefinition Height="40"></RowDefinition>
									<RowDefinition Height="40"></RowDefinition>
									<RowDefinition Height="40"></RowDefinition>
									<RowDefinition Height="40"></RowDefinition>
									<RowDefinition Height="40"></RowDefinition>
									<RowDefinition Height="30"></RowDefinition>
									<RowDefinition Height="30"></RowDefinition>
								</Grid.RowDefinitions>

								<TextBlock Classes="h2" Text="Gamma"  Grid.Column="0" Grid.Row="0"/>
								<TextBox Classes="c1" Text="{Binding GammaCorrections.Gamma }"   Grid.Column="1" />
								<CheckBox Grid.Row="0" Grid.Column="3" Content="Correct" IsChecked="{Binding GammaCorrections.Correct}"/>
								<Slider Minimum="0.5" Maximum="2.0" Value="{Binding GammaCorrections.Gamma}"
										TickFrequency="0.05" IsSnapToTickEnabled="True" Grid.Row="1" Grid.Column="1"/>

								<TextBlock Classes="h2" Text="Saturation"  Grid.Column="0" Grid.Row="2"/>
								<TextBox Classes="c1" Text="{Binding GammaCorrections.Saturation }"   Grid.Column="1" Grid.Row="2" />
								<Slider Minimum="0" Maximum="2.0" Value="{Binding GammaCorrections.Saturation}"
										TickFrequency="0.05" IsSnapToTickEnabled="True" Grid.Row="3" Grid.Column="1"/>

								<TextBlock Classes="h2" Text="Brightness"  Grid.Column="3" Grid.Row="2"/>
								<TextBox Classes="c1" Text="{Binding GammaCorrections.Brightness }"   Grid.Column="4" Grid.Row="2" />
								<Slider Minimum="-1.0" Maximum="1.0" Value="{Binding GammaCorrections.Brightness}"
										TickFrequency="0.05" IsSnapToTickEnabled="True"
										Grid.Row="3" Grid.Column="4"/>

								<TextBlock Classes="h2" Text="Sharpness"  Grid.Column="0" Grid.Row="4"/>
								<TextBox Classes="c1" Text="{Binding GammaCorrections.Sharpness }"   Grid.Column="1" Grid.Row="4" />
								<Slider Minimum="-.5" Maximum=".5" Value="{Binding GammaCorrections.Sharpness}"
										TickFrequency="0.05" IsSnapToTickEnabled="True"
										Grid.Row="5" Grid.Column="1"/>

								<TextBlock Classes="h2" Text="Contrast"  Grid.Column="3" Grid.Row="4"/>
								<TextBox Classes="c1" Text="{Binding GammaCorrections.Contrast }"   Grid.Column="4" Grid.Row="4" />
								<Slider Minimum="-5.0" Maximum="5.0" Value="{Binding GammaCorrections.Contrast}"
										TickFrequency="0.05" IsSnapToTickEnabled="True"
										Grid.Row="5"
										Grid.Column="4"/>


							</Grid>
							<Grid ShowGridLines="False">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80"/>
									<ColumnDefinition Width="80"/>
									<ColumnDefinition Width="80"/>
									<ColumnDefinition Width="80"/>
									<ColumnDefinition Width="80"/>
									<ColumnDefinition Width="80"/>
									<ColumnDefinition Width="80"/>
									<ColumnDefinition Width="80"/>

								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="40"></RowDefinition>
									<RowDefinition Height="40"></RowDefinition>
									<RowDefinition Height="40"></RowDefinition>
									<RowDefinition Height="40"></RowDefinition>
								</Grid.RowDefinitions>
								<TextBlock Classes="h2" Text="Red"  Grid.Column="0" Grid.Row="0"/>
								<TextBox Classes="h2" Text="{Binding GammaCorrections.Red}"  Grid.Column="1" Grid.Row="0"/>
								<Slider Minimum="0.1" Maximum="2.0"
										Value="{Binding GammaCorrections.Red}" TickFrequency="0.1"
										IsSnapToTickEnabled="True"
										Grid.Row="1" Grid.Column="1"/>

								<TextBlock Classes="h2" Text="Blue"  Grid.Column="2" />
								<TextBox Classes="h2" Text="{Binding GammaCorrections.Blue}"  Grid.Column="3" Grid.Row="0"/>
								<Slider Minimum="0.1" Maximum="2.0" Value="{Binding GammaCorrections.Blue}"
										TickFrequency="0.1" IsSnapToTickEnabled="True" Grid.Row="1" Grid.Column="3"/>

								<TextBlock Classes="h2" Text="Green"  Grid.Column="4" Grid.Row="0"/>
								<TextBox Classes="h2" Text="{Binding GammaCorrections.Green}"  Grid.Column="5" Grid.Row="0"/>
								<Slider Minimum="0.1" Maximum="2.0"
										Value="{Binding GammaCorrections.Green}"
										TickFrequency="0.1" IsSnapToTickEnabled="True"
										Grid.Row="1" Grid.Column="5"/>


								<TextBlock Classes="h2" Text="Weight"  Grid.Column="6" Grid.Row="0"/>
								<TextBox Classes="h2" Text="{Binding GammaCorrections.Weight}"  Grid.Column="7" Grid.Row="0"/>
								<Slider Minimum="0.1" Maximum="2.0" Value="{Binding GammaCorrections.Weight}"
										TickFrequency="0.1" IsSnapToTickEnabled="True" Grid.Row="1" Grid.Column="7"/>

								<tcb:ImagedButton LabelText="Save Config"
												  Grid.Column="0"
												  Grid.ColumnSpan="2"
												  Grid.Row="2"
												  ImageSource="avares://TaymadeControls/Assets/save_icon.png"
												  ButtonToolTip="Save Config"
												  Command="{Binding SaveGamma}"
												  />

								<tcb:ImagedButton LabelText="Save Image"
												  Grid.Column="3"
												  Grid.ColumnSpan="2"
												  Grid.Row="2"
												  ImageSource="avares://TaymadeControls/Assets/save_icon.png"
												  ButtonToolTip="Save Image"
												  Click="SaveImage"
												  />

								<tcb:ImagedButton LabelText="Apply Config"
												  Grid.Column="0"
												  Grid.ColumnSpan="2"
												  Grid.Row="3"
												  ImageSource="avares://TaymadeControls/Assets/build.png"
												  ButtonToolTip="Apply Config"
												  Click="ApplyConfig_Click"
												  />

								<tcb:ImagedButton LabelText="Reset To Default"
												  Grid.Column="3"
												  Grid.ColumnSpan="2"
												  Grid.Row="3"
												  ImageSource="avares://TaymadeControls/Assets/save_icon.png"
												  ButtonToolTip="Reset To Default Config"
												  Click="ResetToDefault_Click"
												  />
								<tcb:ImagedButton LabelText="Load Config"
												  Grid.Column="5"
												  Grid.ColumnSpan="2"
												  Grid.Row="3"
												  ImageSource="avares://TaymadeControls/Assets/Refresh.png"
												  ButtonToolTip="Load Config"
												  Click="LoadConfig_Click"
												  />
							</Grid>
						</StackPanel>
						<StackPanel Width="20" Background="LightGray"/>

						<StackPanel Orientation="Horizontal">
							<Border HorizontalAlignment="Center"
									VerticalAlignment="Center"
									BorderBrush="Black"
									BorderThickness="3"
									CornerRadius="5"
									BoxShadow="5 5 10 0 #C0000000"
									Width="500"
									Height="500"
									>
								<Image Source="{Binding RootFolder.CurrentImageItem.ImageBMP}"

									   >
								</Image>
							</Border >
							<StackPanel Width="20"  Background="LightGray"/>
							<Border HorizontalAlignment="Center"
									VerticalAlignment="Center"
									BorderBrush="Black"
									BorderThickness="3"
									CornerRadius="5"
									BoxShadow="5 5 10 0 #C0000000"
									Width="500"
									Height="500"
									>
								<Image Source="{Binding ImageBMPConverted}"


									   >
								</Image>
							</Border >
						</StackPanel>
					</StackPanel>
				</Border>
			</TabItem>
		</TabControl>
	</StackPanel>

</UserControl>
