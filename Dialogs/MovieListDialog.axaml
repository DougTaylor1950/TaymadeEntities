<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1900" d:DesignHeight="1080"
		xmlns:uc="using:TaymadeEntities.Views"
		xmlns:c="using:TaymadeEntities.Controls"
		xmlns:vm="using:TaymadeEntities.ViewModels"

		WindowState="Maximized"
		Height="1080"
		x:DataType="vm:MovieViewModel"
        x:Class="TaymadeEntities.Dialogs.MovieListDialog"
        Title="MovieListDialog"
		>

	<Design.DataContext>
		<vm:MovieViewModel/>
	</Design.DataContext>
		

	<StackPanel Orientation="Vertical" Height="1000">
		<c:MovieListControl Name="MovieList" Height="500" />
		<c:MovieDetailControl Name="MovieDetails" Height="400"/>
		<StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" HorizontalAlignment="Center">
			<Button Content="OK" Margin="5" Command="{Binding Accept}" Name="Accept" >
				
			</Button>
			<Button Content="Cancel" Margin="5" Command="{Binding Cancel}" Name="Cancel" >
				
			</Button>


		</StackPanel>
	</StackPanel>

</Window>
